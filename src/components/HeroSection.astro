---
import { siteContent } from "../data/siteContent";
import { locale } from "../lib/site";

const { t, url } = locale(Astro.url.pathname);
const { hero } = siteContent;
---

<section class="photo-lead home-hero" id="top" aria-labelledby="hero-title">
  <img class="photo-lead__image" src={hero.image} alt={hero.name}
    width="1500" height="1200" loading="eager" fetchpriority="high" />
  <div class="photo-lead__copy">
    <h1 class="hero__title" id="hero-title">
      {t("Discover Napoli", "Scopri Napoli")}
      <span>{t("through my eyes", "con i miei occhi")}</span>
    </h1>
    <div class="hero__footer">
      <div class="hero__credit">
        <picture aria-hidden="true">
          <source media="(prefers-reduced-motion: reduce)" srcset="/images/hero-camera-still.webp" />
          <img src="/images/hero-camera.webp" alt="" width="60" height="60" />
        </picture>
        <div>
          <p class="hero__name">{hero.name}</p>
          <p class="hero__role">{t("Tour guide and photographer", "Guida turistica e fotografo")}</p>
        </div>
      </div>
      <div class="hero__actions">
        <a class="btn btn--primary" href={url(hero.primaryCta.href)}>
          {t(hero.primaryCta.label, "Scopri i tour")}
        </a>
        <a class="hero__portfolio" href={url(hero.secondaryCta.href)}>
          {t(hero.secondaryCta.label, "Guarda il portfolio")} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
