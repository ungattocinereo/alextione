---
import { siteContent } from "../data/siteContent";

const { hero } = siteContent;
---

<section class="hero" id="top">
  <div class="hero__bg">
    <img src={hero.image} alt="Alessandro Tione" loading="eager" />
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content">
    <span class="hero__kicker">{hero.kicker}</span>
    <h1 class="hero__title">
      Discover<br />
      <span class="hero__accent">Napoli</span>
    </h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn--outline-light" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>

  <div class="hero__name-tag">
    <span>{hero.name}</span>
  </div>

  <div class="hero__scroll-hint">
    <span>Scroll</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
  </div>
</section>
