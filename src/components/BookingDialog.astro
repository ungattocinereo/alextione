---
import { locale, tours, tourPath, conditions } from "../lib/site";
import PrivacyAcknowledgment from "./PrivacyAcknowledgment.astro";
import { siteContent } from "../data/siteContent";
import "../styles/booking.css";
const { t, lang, base } = locale(Astro.url.pathname);
const pageTour = tours.find(tour => tourPath(tour) === base.replace(/\/?$/, "/"));
---

<dialog class="booking" id="booking" aria-labelledby="booking-title" data-page-tour={pageTour?.slug}>
  <div class="booking-layout">
    <figure class="booking-photo">
      <div class="booking-pictures" aria-hidden="true"></div>
      <figcaption><small>Napoli, Italia</small><span class="booking-subject">Alex Tione</span></figcaption>
    </figure>
    <div class="booking-page">
      <button class="booking-close" type="button" data-dismiss aria-label={t("Close", "Chiudi")}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13"/></svg>
      </button>
      <section data-compose>
        <h2 id="booking-title" tabindex="-1" autofocus>{t("Write to Alex", "Scrivi ad Alex")}<span aria-hidden="true">.</span></h2>
        <form action="/api/booking/" method="post" class="request"
          data-error={t("Your message didn’t go through. Try again or email me directly.", "Il messaggio non è partito. Riprova o scrivimi via email.")}>
          <input type="hidden" name="language" value={lang} />
          <fieldset>
            <label>{t("What’s it about?", "Di cosa si tratta?")}
              <span class="booking-select"><select name="tour">
                <option value="" data-photo="/images/hero-alex.webp">{t("General enquiry", "Richiesta generale")}</option>
                {tours.map((tour) => <option value={tour.slug} data-photo={tour.cover.src}>{tour[lang].title}</option>)}
              </select></span>
            </label>
            <div class="request-row" data-trip hidden>
              <label>{t("Preferred date", "Data preferita")}<input type="date" name="date" /></label>
              <label>{t("Guests", "Partecipanti")}<input type="number" name="guests" min={conditions.minGuests} max="999" value={conditions.minGuests} /></label>
            </div>
            <div class="request-row request-contact">
              <label>{t("Your name", "Il tuo nome")}<input name="name" autocomplete="name" required maxlength="100" /></label>
              <label>Email<input type="email" name="email" autocomplete="email" required maxlength="254" /></label>
            </div>
            <label><span>{t("Message", "Messaggio")} <em data-optional hidden>{t("(optional)", "(facoltativo)")}</em></span>
              <textarea name="message" rows="2" maxlength="3000"></textarea>
            </label>
            <PrivacyAcknowledgment className="request-consent" />
          </fieldset>
          <p class="booking-error" role="alert" tabindex="-1"></p>
          <button class="booking-send" type="submit">
            <span data-ready>{t("Send message", "Invia messaggio")}</span>
            <span data-busy hidden>{t("Sending…", "Invio…")}</span>
            <span class="booking-send-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 16 16 4M4.5 4H16v11.5"/></svg></span>
          </button>
        </form>
      </section>
      <section class="booking-receipt" data-receipt hidden aria-labelledby="booking-thanks">
        <div class="booking-stamp" aria-hidden="true">
          <span>Napoli</span>
          <svg width="36" height="26" viewBox="0 0 36 26" fill="none"><path pathLength="1" d="m5 14 8 8L32 4" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Italia</span>
        </div>
        <h2 id="booking-thanks" tabindex="-1" aria-describedby="booking-next">{t("Thank you", "Grazie")}<span>!</span></h2>
        <p id="booking-next">
          <span data-delivered>{t("I’ve received your message. I’ll reply to you at", "Ho ricevuto il tuo messaggio. Ti risponderò a")} <strong data-address></strong>.</span>
          <span data-preview hidden>{t("Your message was saved in this preview. No email was sent.", "Il messaggio è stato salvato in anteprima. Nessuna email è stata inviata.")}</span>
        </p>
        <button class="booking-done" type="button" data-dismiss>{t("Close", "Chiudi")}</button>
      </section>
      <footer class="booking-footer">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2" y="4" width="16" height="12" rx="1.5"/><path d="m3 5 7 5 7-5"/></svg>
        <a href={"mailto:" + siteContent.footer.email}>{siteContent.footer.email}</a>
      </footer>
    </div>
  </div>
</dialog>

<script>
  import { trackLead } from "../lib/analytics";
  import { formContext } from "../lib/formContext";

  const dialog = document.querySelector<HTMLDialogElement>("#booking")!;
  const find = <E extends HTMLElement = HTMLElement>(selector: string) => dialog.querySelector<E>(selector)!;
  const form = find<HTMLFormElement>("form");
  const tour = find<HTMLSelectElement>("[name=tour]");
  const date = find<HTMLInputElement>("[name=date]");
  const guests = find<HTMLInputElement>("[name=guests]");
  const message = find<HTMLTextAreaElement>("[name=message]");
  const submit = find<HTMLButtonElement>("[type=submit]");
  const error = find(".booking-error");
  const pictures = find(".booking-pictures");
  const subject = find(".booking-subject");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  let requestedPhoto: HTMLImageElement | undefined;

  function updatePostcard(option: HTMLOptionElement) {
    const src = option.dataset.photo!;
    const title = option.value ? option.text : "Alex Tione";
    if (subject.textContent !== title) {
      subject.textContent = title;
      if (dialog.open && !reducedMotion.matches) {
        subject.animate(
          [{ opacity: 0, transform: "translateY(5px)" }, { opacity: 1, transform: "none" }],
          { duration: 320, easing: "cubic-bezier(.22,1,.36,1)" },
        );
      }
    }
    if (requestedPhoto?.getAttribute("src") === src) return;
    // Crossfade in the open dialog. A fresh opening starts with its own postcard.
    if (!dialog.open) pictures.replaceChildren();
    const photo = new Image();
    requestedPhoto = photo;
    photo.alt = "";
    photo.src = src;
    photo.decode().then(() => {
      if (photo !== requestedPhoto) return;
      const previous = pictures.lastElementChild;
      pictures.replaceChildren(...(previous ? [previous, photo] : [photo]));
    }).catch(() => {
      if (photo !== requestedPhoto) return;
      pictures.replaceChildren();
      requestedPhoto = undefined;
    });
  }

  function selectTour() {
    const selected = Boolean(tour.value);
    updatePostcard(tour.selectedOptions[0]);
    find("[data-trip]").hidden = !selected;
    find("[data-optional]").hidden = !selected;
    guests.disabled = date.disabled = !selected;
    date.required = guests.required = selected;
    message.required = !selected;
    date.min = new Intl.DateTimeFormat("sv-SE", {timeZone: "Europe/Rome"}).format(new Date());
  }
  tour.addEventListener("change", selectTour);
  function setBusy(busy: boolean) {
    submit.disabled = find<HTMLFieldSetElement>("fieldset").disabled = busy;
    find("[data-ready]").hidden = busy;
    find("[data-busy]").hidden = !busy;
    form.setAttribute("aria-busy", String(busy));
  }
  document.querySelectorAll<HTMLElement>("[data-contact-open]").forEach(trigger => {
    trigger.addEventListener("click", () => {
      if (!submit.disabled) {
        tour.value = trigger.dataset.tour || dialog.dataset.pageTour || "";
        selectTour();
        find("[data-compose]").hidden = false;
        find("[data-receipt]").hidden = true;
        dialog.setAttribute("aria-labelledby", "booking-title");
        error.textContent = "";
      }
      dialog.showModal();
      dialog.scrollTop = 0;
    });
  });
  dialog.querySelectorAll("[data-dismiss]").forEach(button => button.addEventListener("click", () => dialog.close()));
  dialog.addEventListener("click", event => {
    if (event.target !== dialog) return;
    const {left, right, top, bottom} = dialog.getBoundingClientRect();
    if (event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom) dialog.close();
  });
  form.addEventListener("submit", async event => {
    event.preventDefault();
    if (submit.disabled) return;
    const payload = Object.fromEntries(new FormData(form));
    Object.assign(payload, formContext());
    setBusy(true);
    error.textContent = "";
    try {
      const res = await fetch(form.action, {
        method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error();
      const result = await res.json();
      if (result.ok !== true) throw new Error();
      if (result.preview === false) trackLead(payload.tour ? "tour" : "general");
      find("[data-address]").textContent = String(payload.email).trim();
      find("[data-preview]").hidden = !result.preview;
      find("[data-delivered]").hidden = Boolean(result.preview);
      const compose = find("[data-compose]");
      const receipt = find("[data-receipt]");
      const previousHeight = compose.offsetHeight;
      compose.hidden = true;
      receipt.hidden = false;
      if (dialog.open && !reducedMotion.matches) {
        receipt.animate(
          [{ height: previousHeight + "px" }, { height: receipt.offsetHeight + "px" }],
          { duration: 400, easing: "cubic-bezier(.22,1,.36,1)" },
        );
      }
      dialog.setAttribute("aria-labelledby", "booking-thanks");
      form.reset();
      if (dialog.open) {
        dialog.scrollTop = 0;
        find("#booking-thanks").focus({preventScroll: true});
      }
    } catch {
      error.textContent = form.dataset.error!;
      if (dialog.open) error.focus();
    } finally {
      setBusy(false);
    }
  });
</script>
