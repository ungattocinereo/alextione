---
import { siteContent } from "../data/siteContent";

const { aboutMe } = siteContent;
---

<section class="section section--muted" id="about">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">About Me</p>
      <h2>{aboutMe.title}</h2>
    </div>

    <div class="about__grid">
      <div class="about__bio">
        {
          aboutMe.paragraphs.map((paragraph) => <p>{paragraph}</p>)
        }
      </div>
      <div class="about__card">
        <h3>Quick Facts</h3>
        <ul>
          {
            aboutMe.highlights.map((highlight) => <li>{highlight}</li>)
          }
        </ul>
        <a href={aboutMe.guideCard.href} target="_blank" rel="noreferrer">
          {aboutMe.guideCard.label}
        </a>
      </div>
    </div>
  </div>
</section>
