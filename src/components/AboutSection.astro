---
import { locale } from "../lib/site";
const {lang,t} = locale(Astro.url.pathname);
import { siteContent } from "../data/siteContent";

const { aboutMe } = siteContent;
---

<section class="section section--muted" id="about">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">{t("About Me","Chi sono")}</p>
      <h2>{t(aboutMe.title,'Sono Alex, guida turistica e fotografo a Napoli')}</h2>
    </div>

    <div class="about__grid">
      <div class="about__bio">
        {
          (lang==='en' ? aboutMe.paragraphs : ['Sono nato a Napoli. Gli anni trascorsi all’estero mi hanno dato un altro sguardo sulla mia città e il desiderio di raccontarla.','Nelle mie passeggiate e nelle fotografie si incontrano storia, cultura urbana e persone.','Mi interessa mostrare la bellezza e la complessità di Napoli, lontano dagli stereotipi.']).map((paragraph) => <p>{paragraph}</p>)
        }
      </div>
      <div class="about__card">
        <h3>{t("Quick Facts","In breve")}</h3>
        <ul>
          {
            (lang==='en' ? aboutMe.highlights : ['Lingue di lavoro: italiano, inglese, spagnolo','Guida turistica abilitata in Campania','Tour e servizi fotografici durante tutto l’anno']).map((highlight) => <li>{highlight}</li>)
          }
        </ul>
        <a href={aboutMe.guideCard.href} target="_blank" rel="noreferrer">
          {t(aboutMe.guideCard.label,'Consulta la scheda ufficiale')}
        </a>
      </div>
    </div>
  </div>
</section>
