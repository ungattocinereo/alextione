---
import { locale } from "../lib/site";
const { t } = locale(Astro.url.pathname);

// Change this ID to point the section at another YouTube video.
const INTERVIEW_VIDEO_ID = "jw33eYrRo6I";
const videoUrl = `https://www.youtube.com/watch?v=${INTERVIEW_VIDEO_ID}`;
---
<section class="section section--dark interview" id="interview" aria-labelledby="interview-title">
  <div class="container">
    <div class="interview__intro">
      <p class="eyebrow">{t("Interview", "Intervista")}</p>
      <h2 id="interview-title">Destination Calcio</h2>
      <p>{t("My interview with Destination Calcio on Naples and football", "La mia intervista con Destination Calcio su Napoli e il calcio")}</p>
    </div>
    <a
      class="interview__preview"
      href={videoUrl}
      target="_blank"
      rel="noreferrer"
      aria-label={t("Watch the interview on YouTube (opens in a new tab)", "Guarda l’intervista su YouTube (si apre in una nuova scheda)")}
    >
      <img
        src="/images/home/interview-destination-calcio.webp"
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        alt=""
      />
      <span class="interview__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </span>
    </a>
  </div>
</section>

<style>
  .interview__intro { max-width: 46rem; margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .interview__intro h2 {
    font-family: "Oswald", sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    margin: .5rem 0 .75rem;
  }
  .interview__intro p:not(.eyebrow) {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.1rem;
    line-height: 1.55;
    margin: 0;
    color: #d1d1cf;
  }
  .interview__preview {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  .interview__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease, opacity .3s ease;
  }
  .interview__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: clamp(64px, 11vw, 96px);
    height: clamp(64px, 11vw, 96px);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 8px 30px rgba(0, 0, 0, .45);
    transition: transform .25s ease, background-color .25s ease;
  }
  .interview__play svg { margin-left: 4px; width: 45%; height: 45%; }
  .interview__preview:hover img { transform: scale(1.03); opacity: .92; }
  .interview__preview:hover .interview__play { transform: scale(1.08); background: var(--accent-hover); }
  .interview__preview:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .interview__preview img, .interview__play { transition: none; }
    .interview__preview:hover img, .interview__preview:hover .interview__play { transform: none; }
  }
</style>
