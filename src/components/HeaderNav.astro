---
import { locale, tours, tourPath } from "../lib/site";
import LanguageLinks from "./LanguageLinks.astro";
import { siteContent } from "../data/siteContent";
import BookingDialog from "./BookingDialog.astro";
const { lang, url, t } = locale(Astro.url.pathname);
const bookLabel = t("My new book", "Il mio nuovo libro");
const photoLinks = [
  [bookLabel, "/book/", t("216 pages on Naples and Maradona", "216 pagine su Napoli e Maradona"), "book"],
  ["Portfolio", "/photo-art/", t("Street life, football and tattoos", "Vita di strada, calcio e tatuaggi"), "portfolio"],
  ["Religione Monoteistica", "/religione-monoteistica/", t("Photographing Diego’s memory since 2018", "Sulle tracce di Diego dal 2018"), "project"],
  [t("Prints & shop", "Stampe e shop"), "/shop/", t("Photo prints, pins and fanzines", "Stampe fotografiche, spille e fanzine"), "prints"],
];
const mobileLinks = [
  [t("Tours", "Tour"), "/tours/"],
  [t("Portfolio", "Portfolio"), "/photo-art/"],
  [bookLabel, "/book/"],
  [t("Maradona Project", "Progetto Maradona"), "/religione-monoteistica/"],
  ["Shop", "/shop/"],
  [t("About me", "Chi sono"), "/about/"],
];
const contactLabel = t("Contact me", "Contattami");
---

<header class="mast" data-mast>
  <div class="mast-bar">
    <a class="mast-logo" href={url("/")} aria-label="Alex Tione">
      <img src="/logo.svg" alt="Alex Tione" width="82" height="36" />
    </a>
    <nav
      id="main-menu"
      class="mast-links"
      aria-label={t("Main menu", "Menu principale")}
    >
      <details>
        <summary>
          Tour{lang === "en" && "s"} <i></i>
        </summary>
        <div class="mast-drop">
          <a class="all-tours" href={url("/tours/")}>
            <img src="/images/menu/all-tours.webp" alt="" width="44" height="44" loading="lazy" />
            <span>{t("All walking tours", "Tutti i tour a piedi")} ↗</span>
            <small>{t("Choose your walk through Naples", "Scegli la tua passeggiata a Napoli")}</small>
          </a>
          {tours.map((tour) => (
            <a href={url(tourPath(tour))}>
              <img src={`/images/menu/${tour.slug}.webp`} alt="" width="44" height="44" loading="lazy" />
              <span>{tour[lang].title}</span>
              <small>{tour[lang].navDescription}</small>
            </a>
          ))}
        </div>
      </details>
      <details>
        <summary>
          {t("Photography", "Fotografia")} <i></i>
        </summary>
        <div class="mast-drop">
          {photoLinks.map(([label, href, description, preview]) => (
            <a href={url(href)}>
              <img class:list={[{ "menu-book-cover": preview === "book" }]} src={`/images/menu/${preview}.webp`} alt="" width="44" height="44" loading="lazy" />
              <span>{label}</span>
              <small>{description}</small>
            </a>
          ))}
        </div>
      </details>
      <a href={url("/shop/")}>{t("Shop", "Shop")}</a>
      <a href={url("/about/")}>{t("About", "Chi sono")}</a>
      <button class="mast-contact" data-contact-open>
        {t("Contact", "Contatti")}
      </button>
    </nav>
    <LanguageLinks />
    <button
      class="mast-toggle"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-haspopup="dialog"
    >
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path d="M3 8h18M3 16h18" />
      </svg>{" "}
      Menu
    </button>
    <button class="mobile-contact" type="button" data-contact-open>
      {contactLabel}
    </button>
  </div>
  <dialog
    id="mobile-menu"
    class="mobile-sheet"
    aria-label={t("Main menu", "Menu principale")}
  >
    <div class="mobile-sheet__frame">
      <div class="mobile-sheet__bar">
        <button
          class="sheet-close"
          autofocus
          aria-label={t("Close menu", "Chiudi menu")}
        >
          <span aria-hidden="true">×</span> Menu
        </button>
        <a class="mast-logo" href={url("/")}>
          <img src="/logo.svg" alt="Alex Tione" width="105" height="20" />
        </a>
        <button class="mobile-contact" data-contact-open>
          {contactLabel}
        </button>
      </div>
      <div class="mobile-sheet__body">
        <p class="mobile-role">
          {t(
            "Tour guide and photographer in Naples",
            "Guida turistica e fotografo a Napoli",
          )}
        </p>
        <nav class="mobile-sections" aria-label={t("Sections", "Sezioni")}>
          {mobileLinks.map(([label, href], index) => (
            <a href={url(href)} style={`--item: ${index}`}>{label}</a>
          ))}
        </nav>
        <div class="mobile-sheet__footer">
          <LanguageLinks fullNames />
          <div class="mobile-socials">
            {siteContent.footer.socialLinks
              .filter((link) => link.label !== "LinkedIn")
              .map((link) => (
                <a href={link.href}>
                  {link.label === "Instagram" ? "Instagram" : "X"}
                </a>
              ))}
            <a href={"mailto:" + siteContent.footer.email}>Email</a>
          </div>
          <small>© Alessandro Tione {new Date().getFullYear()}</small>
        </div>
      </div>
    </div>
  </dialog>
</header>
<BookingDialog />
<script>
  import { setupDesktopNavigation } from "../lib/desktopNavigation";
  const mast = document.querySelector<HTMLElement>("[data-mast]")!;
  const toggle = mast.querySelector<HTMLButtonElement>(".mast-toggle")!;
  const closeMenus = setupDesktopNavigation(mast.querySelector<HTMLElement>(".mast-links")!);
  const sheet = mast.querySelector<HTMLDialogElement>("#mobile-menu")!;
  const scroll = () => {
    if (window.scrollY > 36) mast.classList.add("compact");
    else if (window.scrollY < 20) mast.classList.remove("compact");
  };
  scroll();
  window.addEventListener("scroll", scroll, { passive: true });
  toggle.addEventListener("click", () => {
    const button = toggle.getBoundingClientRect();
    sheet.style.setProperty("--menu-x", (button.left + button.width / 2) + "px");
    sheet.style.setProperty("--menu-y", (button.top + button.height / 2) + "px");
    sheet.showModal();
    toggle.setAttribute("aria-expanded", "true");
  });
  sheet
    .querySelector(".sheet-close")!
    .addEventListener("click", () => sheet.close());
  sheet.addEventListener("close", () =>
    toggle.setAttribute("aria-expanded", "false"),
  );
  sheet.addEventListener(
    "click",
    (event) => {
      if ((event.target as Element).closest("a,[data-contact-open]"))
        sheet.close();
    },
    { capture: true },
  );
  window
    .matchMedia("(min-width: 850px)")
    .addEventListener("change", (event) => {
      if (event.matches && sheet.open) sheet.close();
      closeMenus();
    });
  window.addEventListener("pageshow", () => {
    if (sheet.open) sheet.close();
  });
  mast
    .querySelectorAll<HTMLAnchorElement>("[data-language]")
    .forEach((link) => {
      const updateUrl = () => {
        link.search = location.search;
        link.hash = location.hash;
      };
      updateUrl();
      window.addEventListener("hashchange", updateUrl);
      link.addEventListener("click", () => {
        try {
          localStorage.setItem("alex-language", link.dataset.language!);
        } catch {}
        document.cookie =
          "alex_language=" +
          link.dataset.language +
          ";path=/;max-age=31536000;SameSite=Lax";
      });
    });
</script>
