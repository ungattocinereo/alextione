---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "./HeaderNav.astro";
import FooterSection from "./FooterSection.astro";
import { locale } from "../lib/site";
import { postDate, type Post } from "../lib/ghost";
interface Props { post: Post }
const { post } = Astro.props;
const { lang, t, url } = locale(Astro.url.pathname);
const text = post[lang];
const page = new URL(url(post.path), Astro.site).href;
const author = { "@id": new URL("/about/#alessandro-tione", Astro.site).href };
const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": page + "#article",
  headline: text.title,
  description: text.metaDescription || text.excerpt,
  image: post.image,
  datePublished: post.published,
  dateModified: post.updated,
  inLanguage: lang,
  author,
  publisher: author,
  mainEntityOfPage: page,
  keywords: post.tags.join(", ") || undefined,
};
---

<BaseLayout
  title={(text.metaTitle || text.title) + " · Alessandro Tione"}
  description={text.metaDescription || text.excerpt}
  image={post.image}
  article
>
  <HeaderNav />
  <main class="post">
    <article>
      <header class="post-head">
        <p class="eyebrow">
          <a href={url("/blog/")}>Blog</a> ·
          <time datetime={post.published}>{postDate(post.published, lang)}</time> · {post.minutes} min
        </p>
        <h1>{text.title}</h1>
        {text.excerpt && <p class="post-lead">{text.excerpt}</p>}
      </header>
      {post.image && (
        <img class="post-cover" src={post.image} alt={text.imageAlt || ""} width="1600" height="1000" fetchpriority="high" decoding="async" />
      )}
      <div class="post-body" set:html={text.html} />
      <footer class="post-foot">
        <a href={url("/blog/")}>← {t("All stories", "Tutte le storie")}</a>
        <a href={url("/tours/")}>{t("Walk Naples with me", "Cammina a Napoli con me")} →</a>
      </footer>
    </article>
  </main>
  <FooterSection />
  <script type="application/ld+json" set:html={JSON.stringify(article).replace(/</g, "\\u003c")} />
</BaseLayout>

<style is:global>
  .post { background: var(--bg); padding: clamp(3rem, 7vw, 6rem) 1.25rem clamp(4rem, 10vw, 8rem); }
  .post article { max-width: 44rem; margin-inline: auto; overflow-wrap: anywhere; }
  .post-head .eyebrow { margin: 0; }
  .post-head .eyebrow a { color: inherit; }
  .post-head h1 { font-size: clamp(2.5rem, 6.5vw, 4.6rem); line-height: 1; margin-block: 1rem 1.2rem; text-wrap: balance; }
  .post-lead { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.5; color: var(--text-muted); margin: 0; }
  .post-cover { width: 100%; height: auto; margin-block: clamp(1.8rem, 4vw, 2.8rem); border-radius: var(--control-radius); background: var(--bg-muted); }
  .post-head + .post-body { margin-top: clamp(1.8rem, 4vw, 2.8rem); }

  /* Article text comes from Ghost as HTML, so its elements are styled from here. */
  .post-body { font-size: 1.08rem; line-height: 1.75; }
  .post-body > * { margin-block: 0 1.25rem; }
  .post-body h2, .post-body h3, .post-body h4 { text-transform: none; letter-spacing: -0.01em; line-height: 1.12; margin-block: 2.4rem 0.8rem; }
  .post-body h2 { font-size: clamp(1.6rem, 3.2vw, 2.1rem); }
  .post-body h3 { font-size: clamp(1.25rem, 2.4vw, 1.5rem); }
  .post-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 0.16em; }
  .post-body a:hover { color: var(--accent-hover); }
  .post-body ul, .post-body ol { padding-left: 1.4rem; }
  .post-body li { margin-block: 0.4rem; }
  .post-body blockquote { margin-inline: 0; padding-left: 1.2rem; border-left: 3px solid var(--accent); font-size: 1.15rem; color: var(--azzurro-ink); }
  .post-body hr { border: 0; border-top: 1px solid var(--line-thin); margin-block: 2.5rem; }
  .post-body img, .post-body video, .post-body iframe { max-width: 100%; height: auto; border-radius: var(--control-radius); }
  .post-body figure { margin-inline: 0; margin-block: 2rem; }
  .post-body figcaption { font: 400 0.8rem/1.5 "JetBrains Mono", monospace; color: var(--text-muted); margin-top: 0.6rem; }
  .post-body pre { overflow-x: auto; padding: 1rem; background: var(--bg-muted); border-radius: var(--control-radius); font-size: 0.9rem; }
  .post-body code { font-family: "JetBrains Mono", monospace; font-size: 0.92em; }
  .post-body table { display: block; overflow-x: auto; border-collapse: collapse; }
  .post-body th, .post-body td { border-bottom: 1px solid var(--line-thin); padding: 0.5rem 0.8rem; text-align: left; }
  .post-body .kg-embed-card iframe { width: 100%; aspect-ratio: 16 / 9; }
  .post-body .kg-gallery-row { display: flex; gap: 0.6rem; margin-bottom: 0.6rem; }
  .post-body .kg-gallery-image { flex: 1; }
  .post-body .kg-gallery-image img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 62rem) {
    .post-body .kg-width-wide { margin-inline: -6rem; }
  }

  .post-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line-thin); font: 500 0.85rem/1.5 "JetBrains Mono", monospace; }
  .post-foot a { color: var(--azzurro-ink); }
</style>
