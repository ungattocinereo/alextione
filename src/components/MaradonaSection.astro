---
import { siteContent, religionePage } from "../data/siteContent";

const { maradonaProject } = siteContent;
---

<section class="section section--dark" id="maradona">
  <div class="container">
    <div class="maradona__grid">
      <div class="maradona__visual">
        <img src={religionePage.image} alt="Religione Monoteistica — Maradona tribute in Naples" loading="lazy" />
        <div class="maradona__visual-overlay"></div>
        <span class="maradona__watermark">D10S</span>
      </div>
      <div class="maradona__text">
        <p class="eyebrow">Maradona Project</p>
        <h2>{maradonaProject.title}</h2>
        <p>{maradonaProject.intro}</p>
        <p>{maradonaProject.body}</p>
        <p class="italic">{maradonaProject.argentina}</p>
        <div class="maradona__actions">
          <a class="btn btn--primary" href={maradonaProject.ctaPrimary.href}>
            {maradonaProject.ctaPrimary.label}
          </a>
          <a class="btn btn--outline-light" href={maradonaProject.ctaSecondary.href} target="_blank" rel="noreferrer">
            {maradonaProject.ctaSecondary.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
