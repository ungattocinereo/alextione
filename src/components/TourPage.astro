---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "./HeaderNav.astro";
import FooterSection from "./FooterSection.astro";
import catalog from "../data/tours.json";
import { locale, conditions, type Tour, tourPath, tours } from "../lib/site";
const { tour } = Astro.props as { tour: Tour };
const { lang, t, url, price, duration } = locale(Astro.url.pathname);
const { title, intro, story } = tour[lang];
const closing = (tour[lang] as { closing?: string }).closing;
const testimonials = catalog.testimonials.map((r) => {
  const [y, m, d] = r.date.split("-").map(Number);
  const date = new Date(Date.UTC(y, m - 1, d || 1));
  return {
    ...r,
    when: new Intl.DateTimeFormat(lang, {
      timeZone: "UTC",
      year: "numeric",
      month: "long",
      ...(d ? { day: "numeric" } : {}),
    }).format(date),
  };
});
const next =
  tours[
    (tours.findIndex((item) => item.slug === tour.slug) + 1) % tours.length
  ];
const icons = [
  "M12 7v5l3 2 M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0",
  "M20 7h-8a5 5 0 0 0 0 10h8 M6 10h10 M6 14h9",
  "M3 5h13v10H8l-4 4v-4H3z M18 9h3v10h-4l-3 3v-4",
  "M15 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0 M5 20a7 7 0 0 1 14 0",
  "M3 19h18 M6 16a6 6 0 0 1 12 0 M12 3v3 M4 8l2 2 M20 8l-2 2",
];
const facts = [
  [t("Duration", "Durata"), duration],
  [t("Price", "Prezzo"), price],
  [
    t("Languages", "Lingue"),
    conditions.languages
      .map((code) =>
        new Intl.DisplayNames([lang], { type: "language" }).of(code),
      )
      .join(" / "),
  ],
  [
    t("Minimum group", "Gruppo minimo"),
    conditions.minGuests + t(" guests", " persone"),
  ],
  [
    t("Departs daily", "Partenza giornaliera"),
    conditions.start
      .map((s) =>
        s === "morning"
          ? t("Morning", "Mattina")
          : t("Afternoon", "Pomeriggio"),
      )
      .join(" / "),
  ],
];
---

<BaseLayout
  title={title + t(" in Naples — Alex Tione", " a Napoli — Alex Tione")}
  description={intro}
>
  <HeaderNav />
  <main>
    <header class="photo-lead">
      <img class="photo-lead__image" src={tour.image} alt="" fetchpriority="high" />
      <div class="photo-lead__copy walk-heading">
        <a class="walk-back" href={url("/tours/")}>
          ← {t("Walking tours", "Tour a piedi")}
        </a>
        <h1>{title}</h1>
        <p>{intro}</p>
        <button
          class="btn btn--primary"
          data-contact-open
          data-tour={tour.slug}
        >
          {t("Request availability", "Richiedi disponibilità")} ↗
        </button>
      </div>
    </header>
    <div class="walk-body container">
      <article>
        {story.map((p) => (
          <p>{p}</p>
        ))}
        {closing && <p class="walk-closing">{closing}</p>}
      </article>
      <aside class="walk-facts">
        <h2>{t("Tour details", "Il tour in breve")}</h2>
        <dl>
          {facts.map(([label, value], i) => (
            <div>
              <dt>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icons[i]} />
                </svg>
                {label}
              </dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {conditions.privateAvailable && (
          <p>
            {t(
              "Private tours available on request.",
              "Tour privati disponibili su richiesta.",
            )}
          </p>
        )}
        <button
          class="btn btn--primary"
          data-contact-open
          data-tour={tour.slug}
        >
          {t("Ask Alex", "Scrivi ad Alex")} ↗
        </button>
      </aside>
    </div>
    <section
      class="walk-gallery container"
      aria-label={t("Photographs by Alex", "Fotografie di Alex")}
    >
      {tour.gallery.map((src, i) => (
        <figure>
          <img
            src={src}
            loading="lazy"
            alt={title + " · " + t("photograph", "fotografia") + " " + (i + 1)}
          />
        </figure>
      ))}
    </section>
    <section
      class="walk-reviews container"
      aria-labelledby="walk-reviews-title"
    >
      <h2 id="walk-reviews-title">
        {t("What guests say", "Cosa dicono gli ospiti")}
      </h2>
      <ul>
        {testimonials.map((r) => (
          <li>
            <figure>
              <blockquote lang="en">
                <p>{r.quote}</p>
              </blockquote>
              <figcaption>
                <strong>{r.name}</strong> · {r.tour[lang]} ·
                <time datetime={r.date}>{r.when}</time>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
    {tour.slug === "maradona-tour" && (
      <div class="walk-related container">
        <a href={url("/religione-monoteistica/")}>
          {t(
            "Discover my photographic project",
            "Scopri il mio progetto fotografico",
          )}{" "}
          · Religione Monoteistica ↗
        </a>
      </div>
    )}
    <div class="walk-next">
      <a class="container" href={url(tourPath(next))}>
        <span>{t("Next walk", "La prossima passeggiata")}</span>
        <strong>{next[lang].title} ↗</strong>
      </a>
    </div>
  </main>
  <FooterSection />
</BaseLayout>

<style>
  .walk-closing {
    margin-top: 1.8rem;
    padding: 1rem 1.2rem;
    border-left: 4px solid var(--ink, currentColor);
    background: #f0eee9;
    font: 500 clamp(1.2rem, 2.4vw, 1.7rem) / 1.3 Oswald, sans-serif;
    max-width: 66ch;
  }
  .walk-reviews {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .walk-reviews h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin-bottom: 1.5rem;
  }
  .walk-reviews ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .walk-reviews figure {
    margin: 0;
    height: 100%;
    padding: 1.4rem;
    border: 1px solid var(--line-thin);
    background: #f0eee9;
  }
  .walk-reviews blockquote {
    margin: 0;
    line-height: 1.7;
  }
  .walk-reviews blockquote p {
    margin: 0;
  }
  .walk-reviews figcaption {
    margin-top: 1rem;
    font-size: 0.85rem;
  }
  .walk-reviews time {
    margin-left: 0.3em;
  }
  @media (min-width: 900px) {
    .walk-reviews ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
