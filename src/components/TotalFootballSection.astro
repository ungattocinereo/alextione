---
import { locale } from "../lib/site";
const { t } = locale(Astro.url.pathname);

const SHOP_URL = "https://totalfootballnapoli.it/";
const DIRECTIONS_URL = "https://www.google.com/maps/place/?q=place_id:ChIJdVFSFysJOxMRA1qzY5-EQJw";
---
<section class="section tfn" id="total-football" aria-labelledby="tfn-title">
  <div class="container tfn__grid">
    <figure class="tfn__photo">
      <img
        src="/images/home/tfn-shop.webp"
        width="1100"
        height="1433"
        loading="lazy"
        decoding="async"
        alt={t(
          "Alex and his business partner sitting outside the Total Football Napoli shop window in Naples",
          "Alex e il suo socio seduti davanti alla vetrina del negozio Total Football Napoli, a Napoli"
        )}
      />
    </figure>
    <div class="tfn__copy">
      <p class="eyebrow">{t("The shop", "Il negozio")}</p>
      <h2 id="tfn-title">{t("Come and find me at my shop", "Vieni a trovarmi nel mio negozio")}</h2>
      <p>
        {t(
          "Together with a business partner I have opened Total Football Napoli, Napoli’s first vintage football store. We specialise in the shirts that made Napoli’s history.",
          "Insieme a un socio ho aperto Total Football Napoli, il primo negozio di calcio vintage di Napoli. Siamo specializzati nelle maglie che hanno fatto la storia del Napoli."
        )}
      </p>
      <p>
        {t(
          "We have been open since 15 May 2026, in the historic centre of Naples. Come in and have a look.",
          "Siamo aperti dal 15 maggio 2026, nel centro storico di Napoli. Entra a dare un’occhiata."
        )}
      </p>
      <address class="tfn__address">Via Luigi Settembrini 98<br />{t("Historic centre, Naples", "Centro storico, Napoli")}</address>
      <div class="tfn__actions">
        <a class="btn btn--primary" href={SHOP_URL} target="_blank" rel="noreferrer">
          {t("Discover more", "Scopri di più")}
          <span class="sr-only">{t(" (opens the shop website in a new tab)", " (apre il sito del negozio in una nuova scheda)")}</span>
        </a>
        <a class="tfn__link" href={DIRECTIONS_URL} target="_blank" rel="noreferrer">
          {t("Get directions", "Indicazioni")} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .tfn__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .tfn__photo { margin: 0; }
  .tfn__photo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 640px;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 6px;
  }
  .tfn__copy h2 {
    font-family: "Oswald", sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    margin: .5rem 0 1.25rem;
  }
  .tfn__copy p:not(.eyebrow) {
    font-family: "Plus Jakarta Sans", sans-serif;
    max-width: 52ch;
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .tfn__address {
    font-style: normal;
    font-weight: 600;
    line-height: 1.5;
    margin: 1.5rem 0;
  }
  .tfn__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .tfn__link {
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tfn__link:hover { color: var(--accent-hover); }
  .tfn__link:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  @media (max-width: 800px) {
    .tfn__grid { grid-template-columns: 1fr; }
    .tfn__photo img { max-height: 520px; }
  }
</style>
