---
import AnalyticsChoice from "../components/AnalyticsChoice.astro";
import { structuredData } from "../lib/structuredData";
import { locale } from "../lib/site";
import { approvedReviews } from "../lib/reviews";
const {lang,base,t} = locale(Astro.url.pathname);
import "../styles/global.css";
import "../styles/walks.css";

interface Props {
  title: string;
  description: string;
  /** Sharing image for pages that have their own, such as blog articles. */
  image?: string;
  article?: boolean;
}

const siteUrl = Astro.site!;
const { title, description, image, article } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, "/");
const canonicalUrl = new URL(path, siteUrl).href;
const card = base.split("/").filter(Boolean).at(-1) || "home";
const blog = base.startsWith("/blog/");
const ogImageUrl = image || new URL(`/share/${lang}/${blog ? "home" : card}.jpg?v=alex-portrait`, siteUrl).href;
const imageAlt = t("Portrait of Alessandro Tione among the balconies of Naples", "Ritratto di Alessandro Tione tra i balconi di Napoli");
const shareTitles: Record<string, string> = {
  book: t("Naples and Maradona — Alessandro Tione", "Napoli e Maradona — Alessandro Tione"),
  shop: t("Photographic prints — Alessandro Tione", "Stampe fotografiche — Alessandro Tione"),
};
const shareDescriptions: Record<string, string> = {
  home: t("Walk through Naples with local guide and photographer Alessandro Tione. Discover the city's streets, football culture and people.", "Scopri Napoli con Alessandro Tione, guida e fotografo napoletano, tra vicoli, calcio e storie di quartiere."),
  book: t("Alessandro Tione photographs the shrines, murals and everyday tributes to Diego Maradona in Naples.", "Gli altarini, i murales e gli omaggi quotidiani a Diego Maradona a Napoli nelle fotografie di Alessandro Tione."),
  shop: t("Discover prints of Naples, football and street life by Alessandro Tione.", "Scopri le stampe di Alessandro Tione dedicate a Napoli, al calcio e alla vita di strada."),
  privacy: t("How Alessandro Tione handles enquiries and personal data.", "Come Alessandro Tione gestisce le richieste e i dati personali."),
  legal: t("Professional details and contact information for Alessandro Tione.", "Dati professionali e contatti di Alessandro Tione."),
};
const shareTitle = shareTitles[card] ?? title;
const shareDescription = shareDescriptions[card] ?? description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/oswald.woff2" crossorigin />
    <link rel="alternate" hreflang="en" href={new URL(base,siteUrl).href}/>
    <link rel="alternate" hreflang="it" href={new URL('/it'+base,siteUrl).href}/>
    <link rel="alternate" hreflang="x-default" href={new URL(base,siteUrl).href}/>
    <script is:inline>
      (() => {
        if (document.documentElement.lang === 'it') return;
        let saved = document.cookie.match(/(?:^|; )alex_language=(en|it)(?:;|$)/)?.[1];
        try { saved = localStorage.getItem('alex-language') || saved; } catch {}
        const prefersItalian = (navigator.languages?.length ? navigator.languages : [navigator.language]).some(l => /^it(?:-|$)/i.test(l));
        if (saved === 'it' || (!saved && prefersItalian)) location.replace('/it' + location.pathname + location.search + location.hash);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Alessandro Tione" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Favicon: all formats -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#0a0a0a" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImageUrl} />
    {!image && <meta property="og:image:type" content="image/jpeg" />}
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {!image && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={lang==="it"?"it_IT":"en_US"} />
    <meta property="og:locale:alternate" content={lang==="it"?"en_US":"it_IT"} />
    <meta property="og:site_name" content="AlexTione" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tionealessandro" />
    <meta name="twitter:creator" content="@tionealessandro" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    {!image && <meta name="twitter:image:alt" content={imageAlt} />}

    <!-- Google structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData(siteUrl, path, title, description, ogImageUrl, await approvedReviews())).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <slot />
    <AnalyticsChoice />
  </body>
</html>
