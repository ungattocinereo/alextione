---
import { locale } from "../lib/site";
const {t} = locale(Astro.url.pathname);
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import HeroSection from "../components/HeroSection.astro";
import ToursSection from "../components/ToursSection.astro";
import BookFeature from "../components/BookFeature.astro";
import PhotographySection from "../components/PhotographySection.astro";
import MaradonaSection from "../components/MaradonaSection.astro";
import ShopSection from "../components/ShopSection.astro";
import AboutSection from "../components/AboutSection.astro";
import FooterSection from "../components/FooterSection.astro";
import { siteContent } from "../data/siteContent";
---

<BaseLayout title={t(siteContent.seo.title,'Alessandro Tione — Guida turistica e fotografo a Napoli')} description={t("Explore Naples with Alessandro Tione, a local tour guide and photographer. Find six guided walks, photographs of the city and his new book on Maradona.",'Passeggiate guidate e fotografia a Napoli con Alessandro Tione. Scopri i tour, il portfolio e il progetto Religione Monoteistica.')}>
  <div class="page-shell">
    <HeaderNav />
    <main>
      <HeroSection />
      <ToursSection />
      <BookFeature />
      <PhotographySection />
      <MaradonaSection />
      <ShopSection />
      <AboutSection />
    </main>
    <FooterSection />
  </div>

</BaseLayout>
