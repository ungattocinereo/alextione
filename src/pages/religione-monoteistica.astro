---
import { locale } from "../lib/site";
const {lang,t} = locale(Astro.url.pathname);
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FooterSection from "../components/FooterSection.astro";
import { religionePage } from "../data/siteContent";

import { progetto } from "../data/progetto";
const { image, ctaFanzine } = religionePage;
const hero = lang === "it" ? {...religionePage.hero,...progetto.hero} : religionePage.hero;
const sections = religionePage.sections.map((s,i) => lang==="it" ? {...s,...progetto.sections[i]} : s);
---

<BaseLayout
  title={t(religionePage.seo.title,'Religione Monoteistica — Il progetto di Alex Tione')}
  description={t(religionePage.seo.description,'Il legame tra Napoli e Maradona nelle fotografie di Alessandro Tione, dal 2018 a oggi.')}
>
  <div class="page-shell">
    <HeaderNav />
    <main>
      <!-- HERO -->
      <section class="rm-hero">
        <div class="rm-hero__content">
          <p class="eyebrow">{hero.kicker}</p>
          <h1>{hero.title}<br /><span class="accent">{hero.titleAccent}</span></h1>
        </div>
        <img class="rm-hero__photo" src={image} alt={t("Maradona tribute in Naples","Omaggio a Maradona a Napoli")} fetchpriority="high" />
      </section>

      <!-- INTRO -->
      <section class="rm-intro">
        <div class="container">
          <div class="rm-intro__grid">
            <div class="rm-intro__text">
              <p>{hero.intro}</p>
              <p>{hero.body}</p>
              <p>{hero.insight}</p>
              <p class="rm-intro__provocative">{hero.provocative}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTIONS -->
      {sections.map((section, i) => (
        <section class={`rm-detail ${i % 2 !== 0 ? 'rm-detail--reversed' : ''}`} id={section.id}>
          <div class="rm-detail__image">
            <img src={section.image} alt={section.title} loading="lazy" />
          </div>
          <div class="rm-detail__content">
            <h2>{section.title}</h2>
            {section.paragraphs.map((p) => (
              <p class="rm-detail__text">{p}</p>
            ))}
          </div>
        </section>
      ))}

      <section id="buenos-aires" class="project-news container">
        <h2>Buenos Aires 2025</h2>
        <p>{t('Religione Monoteistica was selected for the first International Congress on Diego Armando Maradona, scheduled for 6–8 November 2025 at the Faculty of Social Sciences of the University of Buenos Aires.','Religione Monoteistica è stato selezionato per il primo Congresso internazionale su Diego Armando Maradona, in programma dal 6 all’8 novembre 2025 alla Facoltà di Scienze Sociali dell’Università di Buenos Aires.')}</p>
      </section>
    </main>
    <div class="footer-gradient-wrap">
      <!-- CTA BOTTOM -->
      <section class="section section--dark rm-cta">
        <div class="container publication-contact">
          <h2>{t('The photographic fanzine','La fanzine fotografica')}</h2>
          <div class="rm-cta__actions">
            <a class="btn btn--primary" href={ctaFanzine.href} target="_blank" rel="noreferrer">
              {t(ctaFanzine.label,'Acquista la fanzine')}
            </a>
            <button class="btn btn--outline-light" data-contact-open>
              {t("Send me a request","Scrivimi")}
            </button>
          </div>
        </div>
      </section>
      <FooterSection />
    </div>
  </div>
</BaseLayout>
