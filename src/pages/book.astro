---
import { locale } from "../lib/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FooterSection from "../components/FooterSection.astro";
import BookFeature from "../components/BookFeature.astro";
import BookFilm from "../components/BookFilm.astro";
import BookRequest from "../components/BookRequest.astro";

const { t, url } = locale(Astro.url.pathname);
const details = [
  [t("Photographs and text", "Fotografie e testi"), "Alessandro Tione"],
  [t("Format", "Formato"), "23 × 30 cm"],
  [t("Pages", "Pagine"), "216"],
  [t("Cover", "Copertina"), t("350 g/m² matte paper", "Carta opaca da 350 g/m²")],
  [t("Inside pages", "Pagine interne"), "Symbol Freelife Satin (FSC®), 150 g/m²"],
];
---
<BaseLayout title={t("Religione Monoteistica · The new book by Alessandro Tione", "Religione Monoteistica · Il nuovo libro di Alessandro Tione")}
  description={t("Browse the photobook, request a copy or join Alessandro Tione for the launch at Magazzini Fotografici in Naples on 12 December 2026 at 6 PM.", "Sfoglia il libro, richiedi una copia o vieni alla presentazione con Alessandro Tione da Magazzini Fotografici a Napoli il 12 dicembre 2026 alle 18.")}>
  <div class="page-shell">
    <HeaderNav />
    <main>
      <BookFeature detail />
      <section class="book-details container">
        <BookFilm />
        <div>
          <h2>{t("Inside the book", "Dentro il libro")}</h2>
          <dl>
            {details.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>
          <a class="book-link" href={url("/religione-monoteistica/")}>{t("About the photographic project", "Il progetto fotografico")} <span aria-hidden="true">→</span></a>
        </div>
      </section>
      <BookRequest />
    </main>
    <FooterSection />
  </div>
</BaseLayout>
<style>
  main { background: var(--text-light); }
  .book-details {
    display: grid; align-items: center; grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 7vw, 7rem); padding-block: clamp(3rem, 7vw, 7rem);
  }
  dl { margin: 1.8rem 0 .8rem; }
  dl div {
    display: grid; grid-template-columns: minmax(7rem, .8fr) 1.2fr;
    gap: 1rem; border-top: 1px solid var(--line-thin); padding: .8rem 0;
  }
  dt { color: var(--text-muted); }
  dd { margin: 0; font-weight: 600; }
  @media (max-width: 700px) { .book-details { grid-template-columns: 1fr; } }
</style>
