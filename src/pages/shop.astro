---
import { locale } from "../lib/site";
const {lang,t} = locale(Astro.url.pathname);
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FooterSection from "../components/FooterSection.astro";
import { shopPageData } from "../data/siteContent";

const categoryName = (name:string) => lang === 'it' ? ({'Print Photography':'Stampe fotografiche',Pins:'Spille'}[name] ?? name) : name;
const { fanzine, categories } = shopPageData;
---

<BaseLayout
  title={t("Photography prints, pins and fanzines — Alex Tione", "Stampe fotografiche, spille e fanzine — Alex Tione")}
  description={t('Photography prints, pins and fanzines by Alessandro Tione.','Stampe fotografiche, spille e fanzine di Alessandro Tione.')}
>
  <div class="page-shell">
    <HeaderNav />
    <main>
      <!-- HERO — FANZINE -->
      <section class="shop-hero">
        <div class="shop-hero__image">
          <img src={fanzine.image} alt={fanzine.title} />
        </div>
        <div class="shop-hero__content">
          <p class="eyebrow">Fanzine</p>
          <h1>Religione<br /><span class="accent">Monoteistica</span></h1>
          <p class="shop-hero__desc">{t(fanzine.description,'Il titolo è una provocazione: Napoli è tutt’altro che monoteista, ma quando si parla di calcio, nel cuore dei napoletani c’è un solo dio, Diego Armando Maradona.')}</p>
          <a class="btn btn--primary" href={fanzine.vintedUrl} target="_blank" rel="noreferrer">
            {t('Buy on Vinted','Acquista su Vinted')} ↗
          </a>
        </div>
      </section>

      <!-- CATEGORY NAV -->
      <nav class="shop-nav">
        <div class="container">
          <div class="shop-nav__links">
            {categories.map((cat) => (
              <a class="shop-nav__link" href={`#${cat.title.toLowerCase().replace(/\s+/g, '-')}`}>
                {categoryName(cat.title)}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- PRODUCT CATEGORIES -->
      {categories.map((category, catIndex) => (
        <section
          class={`shop-category ${catIndex % 2 !== 0 ? 'shop-category--dark' : ''}`}
          id={category.title.toLowerCase().replace(/\s+/g, '-')}
        >
          <div class="container">
            <div class="shop-category__header">
              <h2>{categoryName(category.title)}</h2>
              {category.paperNote && <p class="shop-category__subtitle">{category.paperNote[lang]}</p>}
              <p class="shop-category__subtitle">{t(category.subtitle,category.title==='Pins'?'Per ordini fuori Europa, scrivimi direttamente.':'Per ordini fuori Europa, scrivimi direttamente. Cornice esclusa.')}</p>
            </div>

            <div class={`shop-products ${category.products.length <= 6 ? 'shop-products--few' : ''}`}>
              {category.products.map((product) => (
                <a class="shop-product" href={product.vintedUrl} target="_blank" rel="noreferrer">
                  <div class="shop-product__image">
                    <img src={product.image} alt={product.title} loading="lazy" />
                    <div class="shop-product__overlay">
                      <span class="shop-product__buy-label">{t('Buy on Vinted','Acquista su Vinted')} ↗</span>
                    </div>
                  </div>
                  <div class="shop-product__info">
                    <h3>{product.title}</h3>
                    {product.prices && (
                      <ul class="shop-product__prices" aria-label={t('Available sizes and prices','Formati e prezzi')}>
                        {product.prices.map((p) => (
                          <li class="shop-product__price">
                            <span class="shop-product__size">{p.size}</span>
                            <strong class="shop-product__amount">{p.price}</strong>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))}

    </main>
    <div class="footer-gradient-wrap">
      <!-- CTA BOTTOM -->
      <section class="section section--dark tours-cta">
        <div class="container publication-contact">
          <h2>{t('Orders and shipping','Ordini e spedizioni')}</h2>
          <button class="btn btn--outline-light" data-contact-open>
            {t("Send me a request","Scrivimi")}
          </button>
        </div>
      </section>
      <FooterSection />
    </div>
  </div>
</BaseLayout>
