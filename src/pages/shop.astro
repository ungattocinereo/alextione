---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FooterSection from "../components/FooterSection.astro";
import { shopPageData } from "../data/siteContent";

const { fanzine, categories } = shopPageData;
---

<BaseLayout
  title="Shop — AlexTione"
  description="Shop prints, posters, pins, and the Religione Monoteistica fanzine by Alessandro Tione. Naples photography and Maradona-inspired art."
>
  <div class="page-shell">
    <HeaderNav />
    <main>
      <!-- HERO — FANZINE -->
      <section class="shop-hero">
        <div class="shop-hero__image">
          <img src={fanzine.image} alt={fanzine.title} />
        </div>
        <div class="shop-hero__content">
          <p class="eyebrow">Fanzine</p>
          <h1>Religione<br /><span class="accent">Monoteistica</span></h1>
          <p class="shop-hero__desc">{fanzine.description}</p>
          <a class="btn btn--primary" href={fanzine.vintedUrl} target="_blank" rel="noreferrer">
            Buy on Vinted &rarr;
          </a>
        </div>
      </section>

      <!-- CATEGORY NAV -->
      <nav class="shop-nav">
        <div class="container">
          <div class="shop-nav__links">
            {categories.map((cat) => (
              <a class="shop-nav__link" href={`#${cat.title.toLowerCase().replace(/\s+/g, '-')}`}>
                {cat.title}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- PRODUCT CATEGORIES -->
      {categories.map((category, catIndex) => (
        <section
          class={`shop-category ${catIndex % 2 !== 0 ? 'shop-category--dark' : ''}`}
          id={category.title.toLowerCase().replace(/\s+/g, '-')}
        >
          <div class="container">
            <div class="shop-category__header">
              <h2>{category.title}</h2>
              <p class="shop-category__subtitle">{category.subtitle}</p>
            </div>

            <div class={`shop-products ${category.products.length <= 6 ? 'shop-products--few' : ''}`}>
              {category.products.map((product) => (
                <a class="shop-product" href={product.vintedUrl} target="_blank" rel="noreferrer">
                  <div class="shop-product__image">
                    <img src={product.image} alt={product.title} loading="lazy" />
                    <div class="shop-product__overlay">
                      <span class="shop-product__buy-label">Buy on Vinted &rarr;</span>
                    </div>
                  </div>
                  <div class="shop-product__info">
                    <h3>{product.title}</h3>
                    {product.prices && (
                      <div class="shop-product__prices">
                        {product.prices.map((p) => (
                          <span class="shop-product__price">{p.size} — <strong>{p.price}</strong></span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))}

      <!-- CTA BOTTOM -->
      <section class="section section--dark tours-cta">
        <div class="container" style="text-align:center; display:grid; gap:1.5rem; justify-items:center;">
          <h2>Naples is calling.<br />Will you answer?</h2>
          <p style="color:rgba(255,255,255,0.55); max-width:45ch; font-size:0.95rem;">
            This city isn't just a destination — it's a story waiting to be lived. Step beyond the postcards and dive into its hidden corners.
          </p>
          <button class="btn btn--outline-light" data-contact-open>
            Send Me a Request
          </button>
        </div>
      </section>
    </main>
    <FooterSection />
  </div>
</BaseLayout>
