---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FooterSection from "../components/FooterSection.astro";
import ToursSection from "../components/ToursSection.astro";
import { locale } from "../lib/site";
const { t, price, duration } = locale(Astro.url.pathname);
---

<BaseLayout
  title={t("Walking tours in Naples — Alessandro Tione", "Tour a piedi a Napoli — Alessandro Tione")}
  description={t(
    "Explore six guided walks in Naples, from Maradona’s street shrines to the food stalls of the Pignasecca. Compare routes, prices and availability.",
    "Sei passeggiate guidate a Napoli, dagli altarini di Maradona ai banchi della Pignasecca. Confronta itinerari e prezzi e chiedi la disponibilità.",
  )}
>
  <HeaderNav />
  <main class="catalog">
    <header class="catalog-head container">
      <p class="eyebrow">{t("Walking tours", "Tour a piedi")}</p>
      <h1>
        Napoli <em>Svelata</em>
      </h1>
      <p>
        {t(
          "Six ways to discover my city, from the shrines of Forcella to the stalls of the Pignasecca.",
          "Sei modi per scoprire la mia città, dagli altarini di Forcella ai banchi della Pignasecca.",
        )}
      </p>
      <p>{t(`Walks with Alessandro Tione last ${duration} and are available in Italian and English. The listed price is ${price}.`, `Le passeggiate con Alessandro Tione durano ${duration} e si svolgono in italiano o in inglese. Il prezzo indicato è ${price}.`)}</p>
    </header>
    <ToursSection catalog />
  </main>
  <FooterSection />
</BaseLayout>
