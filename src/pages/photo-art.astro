---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FooterSection from "../components/FooterSection.astro";
import CollaborationForm from "../components/CollaborationForm.astro";
import sharp from "sharp";

import { locale } from "../lib/site";
const {lang,t} = locale(Astro.url.pathname);

// To add an album, append an object here and give it an Italian title in `italianTitles`.
// `id` becomes the #anchor and the folder name under /images/photo-art/.
// `date` (optional, "YYYY-MM") is shown as a small month/year label under the heading,
// e.g. { id: "matrimonio", title: "Wedding Photography", date: "2026-06", images: [...] }.
const albums: { id: string; title: string; date?: string; images: { src: string; alt: string }[] }[] = [
  {
    id: "football",
    title: "Football Photography",
    images: [
      { src: "/images/photo-art/football/football-1.jpg", alt: "Buenos Aires 2024 - Football" },
      { src: "/images/photo-art/football/football-2.jpg", alt: "Buenos Aires 2024 - Match" },
      { src: "/images/photo-art/football/football-3.jpg", alt: "September 2023 - Stadium" },
      { src: "/images/photo-art/football/football-4.jpg", alt: "Football Photography" },
    ],
  },
  {
    id: "tattoo",
    title: "Tattoo Photography",
    images: [
      { src: "/images/photo-art/tattoo/tattoo-1.webp", alt: "La Plata 2024 - Tattoo" },
      { src: "/images/photo-art/tattoo/tattoo-2.jpg", alt: "October 2023 - Tattoo Portrait" },
      { src: "/images/photo-art/tattoo/tattoo-3.jpeg", alt: "Tattoo Detail" },
      { src: "/images/photo-art/tattoo/tattoo-4.webp", alt: "Tattoo Photography" },
    ],
  },
  {
    id: "street",
    title: "Street Photography",
    images: [
      { src: "/images/photo-art/street/street-1.webp", alt: "Paris 2023 - Street" },
      { src: "/images/photo-art/street/street-2.webp", alt: "Tel Aviv - Street" },
      { src: "/images/photo-art/street/street-3.jpg", alt: "Berlin 2022 - Street" },
      { src: "/images/photo-art/street/street-4.jpg", alt: "Street Photography" },
    ],
  },
  {
    id: "scudetto-2025",
    title: "Scudetto Napoli 2025",
    images: [
      { src: "/images/photo-art/scudetto-2025/scudetto25-1.jpg", alt: "Scudetto Napoli 2025" },
      { src: "/images/photo-art/scudetto-2025/scudetto25-2.jpg", alt: "Scudetto Napoli 2025 - Celebration" },
      { src: "/images/photo-art/scudetto-2025/scudetto25-3.jpg", alt: "Scudetto Napoli 2025 - Fans" },
      { src: "/images/photo-art/scudetto-2025/scudetto25-4.jpg", alt: "Scudetto Napoli 2025 - Night" },
      { src: "/images/photo-art/scudetto-2025/scudetto25-5.jpg", alt: "Scudetto Napoli 2025 - Streets" },
      { src: "/images/photo-art/scudetto-2025/scudetto25-6.jpg", alt: "Scudetto Napoli 2025 - Party" },
    ],
  },
  {
    id: "scudetto-2023",
    title: "Scudetto Napoli 2023",
    images: [
      { src: "/images/photo-art/scudetto-2023/scudetto23-1.jpg", alt: "Scudetto Napoli 2023" },
      { src: "/images/photo-art/scudetto-2023/scudetto23-2.jpg", alt: "Scudetto Napoli 2023 - Celebration" },
      { src: "/images/photo-art/scudetto-2023/scudetto23-3.jpg", alt: "Scudetto Napoli 2023 - Fans" },
      { src: "/images/photo-art/scudetto-2023/scudetto23-4.jpg", alt: "Scudetto Napoli 2023 - April 2023" },
      { src: "/images/photo-art/scudetto-2023/scudetto23-5.jpg", alt: "Scudetto Napoli 2023 - May 2023" },
      { src: "/images/photo-art/scudetto-2023/scudetto23-6.jpg", alt: "Scudetto Napoli 2023 - Party" },
    ],
  },
];
const italianTitles: Record<string, string> = {
  football: "Fotografia di calcio",
  tattoo: "Fotografia di tatuaggi",
  street: "Fotografia di strada",
  "scudetto-2025": "Scudetto Napoli 2025",
  "scudetto-2023": "Scudetto Napoli 2023",
  // matrimonio: "Fotografia di matrimonio",
};
const labels:Record<string,string> = {Football:'Calcio',Match:'Partita',Stadium:'Stadio',September:'Settembre',Tattoo:'Tatuaggio',October:'Ottobre',Portrait:'Ritratto',Photography:'Fotografia',Detail:'Dettaglio',Paris:'Parigi',Street:'Strada',Berlin:'Berlino',Celebration:'Festa',Fans:'Tifosi',Night:'Notte',Streets:'Strade',Party:'Festa',April:'Aprile',May:'Maggio'};

const previewOf = (src: string) => src.replace('/photo-art/', '/previews/').replace(/\.[^.]+$/,'.webp');
const dimensions = new Map<string, { width: number; height: number }>();
for (const album of albums) for (const img of album.images) {
  const meta = await sharp(`public${previewOf(img.src)}`).metadata();
  dimensions.set(img.src, { width: meta.width ?? 3, height: meta.height ?? 2 });
}
const monthYear = (value?: string) => {
  const match = value?.match(/^(\d{4})-(\d{2})$/);
  return match ? new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(+match[1], +match[2] - 1, 1))) : '';
};
const localized = albums.map((a) => ({
  ...a,
  title: lang === 'en' ? a.title : italianTitles[a.id] ?? a.title,
  dateLabel: monthYear(a.date),
  images: a.images.map(img => ({
    ...img,
    alt: lang === 'en' ? img.alt : img.alt.replace(/\b[A-Za-z]+\b/g,word=>labels[word] ?? word),
    preview: previewOf(img.src),
    ...dimensions.get(img.src)!,
  })),
}));
---

<BaseLayout title={t("Portfolio — Alessandro Tione, Naples photographer", "Portfolio — Alessandro Tione, fotografo a Napoli")} description={t("Portfolio of football, tattoo and street photography by Alessandro Tione, with the Napoli Scudetto celebrations of 2023 and 2025.","Portfolio di fotografia di calcio, tatuaggi e strada di Alessandro Tione, con i festeggiamenti per gli scudetti del Napoli 2023 e 2025.")}>
  <div class="page-shell">
    <HeaderNav />

    <main>
      <!-- HERO -->
      <section class="photo-lead">
        <img class="photo-lead__image" src="/images/photo-art/street/street-1.webp" alt="" fetchpriority="high" />
        <div class="photo-lead__copy pa-hero__content">
          <span class="pa-hero__kicker">{t("Photography", "Fotografia")}</span>
          <h1 class="pa-hero__title">Portfolio</h1>
          <p class="pa-hero__subtitle">{t('Football, tattoos and street photography','Calcio, tatuaggi e fotografia di strada')}</p>
          <nav class="pa-hero__nav" aria-label={t("Album navigation","Album fotografici")}>
            {localized.map((album, i) => (
              <a href={`#${album.id}`} class="pa-hero__nav-link" style={`--delay: ${i * 0.08}s`}>{album.title}</a>
            ))}
          </nav>
        </div>
      </section>

      <!-- ALBUMS -->
      <div class="folio">
        {localized.map((album) => (
          <section class="folio-album" id={album.id} aria-labelledby={`${album.id}-title`}>
            <div class="folio-wrap">
              <h2 class="folio-title" id={`${album.id}-title`}>{album.title}</h2>
              {album.dateLabel && <p class="folio-date">{album.dateLabel}</p>}
              {album.id === "football" && (
                <p class="folio-link">Portfolio: <a href="https://alextioneportfolio.my.canva.site/" rel="noopener">alextioneportfolio.my.canva.site</a></p>
              )}
              <div class="folio-grid">
                {album.images.map((img, imgIndex) => (
                  <button type="button" class="folio-item" data-lightbox-trigger data-album={album.id} data-index={imgIndex}>
                    <img src={img.preview} alt={img.alt} width={img.width} height={img.height} data-full={img.src} loading={imgIndex < 2 && album.id === "football" ? "eager" : "lazy"} decoding="async" />
                  </button>
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>

      <!-- COLLABORATE -->
      <section class="folio-collab" aria-labelledby="collab-title">
        <div class="folio-wrap folio-collab__grid">
          <div class="folio-collab__intro">
            <h2 id="collab-title">{t("Let's collaborate and make a good project together", "Collaboriamo e realizziamo insieme un bel progetto")}</h2>
            <p class="folio-collab__connect">{t("Let's connect", "Restiamo in contatto")}</p>
            <ul class="folio-collab__social">
              <li><a href="https://www.instagram.com/alextione/" rel="noopener" target="_blank">{t("My Instagram", "Il mio Instagram")} <span aria-hidden="true">↗</span><span class="sr-only"> ({t("opens in a new tab", "si apre in una nuova scheda")})</span></a></li>
              <li><a href="https://x.com/tionealessandro" rel="noopener" target="_blank">{t("My X (Twitter)", "Il mio X (Twitter)")} <span aria-hidden="true">↗</span><span class="sr-only"> ({t("opens in a new tab", "si apre in una nuova scheda")})</span></a></li>
            </ul>
          </div>
          <CollaborationForm />
        </div>
      </section>
    </main>

    <!-- LIGHTBOX -->
    <div class="pa-lightbox" data-lightbox aria-hidden="true">
      <div class="pa-lightbox__backdrop" data-lightbox-close></div>
      <button class="pa-lightbox__close" data-lightbox-close aria-label={t("Close","Chiudi")}>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button class="pa-lightbox__nav pa-lightbox__nav--prev" data-lightbox-prev aria-label={t("Previous","Precedente")}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15,18 9,12 15,6"/></svg>
      </button>
      <div class="pa-lightbox__stage">
        <img class="pa-lightbox__img" alt="" />
      </div>
      <button class="pa-lightbox__nav pa-lightbox__nav--next" data-lightbox-next aria-label={t("Next","Successiva")}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9,6 15,12 9,18"/></svg>
      </button>
      <div class="pa-lightbox__counter">
        <span data-lightbox-current>1</span> / <span data-lightbox-total>4</span>
      </div>
    </div>

    <FooterSection />
  </div>

  <script>
    // ── Lightbox ──
    const lightbox = document.querySelector('[data-lightbox]') as HTMLElement;
    const lightboxImg = lightbox?.querySelector('.pa-lightbox__img') as HTMLImageElement;
    const currentEl = lightbox?.querySelector('[data-lightbox-current]') as HTMLElement;
    const totalEl = lightbox?.querySelector('[data-lightbox-total]') as HTMLElement;

    let currentAlbum: HTMLImageElement[] = [];
    let currentIndex = 0;

    function openLightbox(albumId: string, index: number) {
      const items = document.querySelectorAll(`[data-album="${albumId}"] img`) as NodeListOf<HTMLImageElement>;
      currentAlbum = Array.from(items);
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (!currentAlbum[currentIndex]) return;
      lightboxImg.src = currentAlbum[currentIndex].dataset.full!;
      lightboxImg.alt = currentAlbum[currentIndex].alt;
      currentEl.textContent = String(currentIndex + 1);
      totalEl.textContent = String(currentAlbum.length);
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % currentAlbum.length;
      updateLightbox();
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + currentAlbum.length) % currentAlbum.length;
      updateLightbox();
    }

    document.querySelectorAll('[data-lightbox-trigger]').forEach((el) => {
      el.addEventListener('click', () => {
        const album = (el as HTMLElement).dataset.album!;
        const index = parseInt((el as HTMLElement).dataset.index!, 10);
        openLightbox(album, index);
      });
    });

    document.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', closeLightbox);
    });

    document.querySelector('[data-lightbox-next]')?.addEventListener('click', nextSlide);
    document.querySelector('[data-lightbox-prev]')?.addEventListener('click', prevSlide);

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextSlide();
      if (e.key === 'ArrowLeft') prevSlide();
    });

  </script>
</BaseLayout>

  <style>
    .pa-hero__title { font-size: clamp(3rem, 9.5vw, 9rem); overflow-wrap: normal; word-break: normal; }
    .folio { background: #fff; color: #0b0b0b; }
    .folio-wrap { width: min(1280px, calc(100% - 2.5rem)); margin-inline: auto; }
    .folio-album { padding-block: clamp(3rem, 7vw, 6rem) 0; scroll-margin-top: var(--mast-height); }
    .folio-album:last-child { padding-bottom: clamp(3rem, 7vw, 6rem); }
    .folio-title {
      font-family: "Oswald", sans-serif; font-weight: 700; text-transform: uppercase;
      font-size: clamp(2.6rem, 9vw, 8rem); line-height: .95; letter-spacing: -.01em;
      color: var(--accent); text-wrap: balance; overflow-wrap: anywhere; margin: 0;
    }
    .folio-date { margin: .8rem 0 0; font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; color: #4a4a4a; }
    .folio-link { margin: 1rem 0 0; font-size: clamp(1rem, 1.6vw, 1.25rem); overflow-wrap: anywhere; }
    .folio-link a { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
    .folio-grid { margin-top: clamp(1.5rem, 4vw, 3rem); columns: 2; column-gap: clamp(.75rem, 2vw, 1.5rem); }
    .folio-item {
      display: block; width: 100%; padding: 0; margin: 0 0 clamp(.75rem, 2vw, 1.5rem); border: 0;
      background: #eee; cursor: zoom-in; break-inside: avoid; overflow: hidden;
    }
    .folio-item img { display: block; width: 100%; height: auto; }
    .folio-item:hover img { opacity: .92; }
    .folio-item:focus-visible, .folio-link a:focus-visible, .folio-collab a:focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 3px; }
    @media (max-width: 640px) { .folio-grid { columns: 1; } }

    .folio-collab { background: #000; color: #fff; padding-block: clamp(3.5rem, 8vw, 7rem); scroll-margin-top: var(--mast-height); }
    .folio-collab__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
    .folio-collab h2 {
      font-family: "Oswald", sans-serif; font-weight: 700; text-transform: uppercase; color: #fff;
      font-size: clamp(2.2rem, 5.5vw, 4.6rem); line-height: 1; text-wrap: balance; overflow-wrap: anywhere; margin: 0;
    }
    .folio-collab__connect { margin: clamp(1.5rem, 3vw, 2.5rem) 0 .6rem; font-size: 1.15rem; color: #d6d6d6; }
    .folio-collab__social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; }
    .folio-collab__social a { color: #fff; font-size: 1.25rem; text-decoration: underline; text-underline-offset: .2em; display: inline-block; padding-block: .3rem; }
    .folio-collab__social a:hover { color: var(--accent-soft); }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (max-width: 860px) { .folio-collab__grid { grid-template-columns: minmax(0, 1fr); } }
  </style>
